# Supabase - Projekteinstellungen -> API
# Diese beiden Werte sind oeffentlich und landen im Browser-Bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig. Niemals mit NEXT_PUBLIC_ praefixen, niemals committen.
SUPABASE_SERVICE_ROLE_KEY=

# Basis-URL fuer Metadaten und Canonicals
NEXT_PUBLIC_SITE_URL=http://localhost:3000
